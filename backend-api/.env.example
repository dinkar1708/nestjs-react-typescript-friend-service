# Copy to .env.dev or .env.prod and adjust values
# DATABASE_URL: Swap for any PostgreSQL - local, Supabase, Railway, Neon, etc.

DATABASE_URL=postgresql://postgres:password@localhost:5432/nestconnect_dev

# JWT_SECRET must be at least 32 characters for security
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

PORT=4000

NODE_ENV=development

# CORS - Required in production, optional in development
# ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
